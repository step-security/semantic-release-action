{
  "name": "@step-security/semantic-release-action",
  "private": true,
  "version": "8.1.0",
  "description": "GitHub Action for Semantic Release",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.js --bundle --platform=node --format=esm --banner:js=\"import {createRequire as __cr} from 'module'; const require = __cr(import.meta.url);\" --conditions=import --external:typescript --external:semantic-release --outfile=dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/step-security/semantic-release-action.git"
  },
  "keywords": [
    "semantic-release",
    "action"
  ],
  "author": "step-security",
  "publisher": "step-security",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/step-security/semantic-release-action/issues"
  },
  "homepage": "https://github.com/step-security/semantic-release-action#readme",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/io": "^3.0.2",
    "axios": "^1.20.0",
    "semantic-release": "^25.0.9"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  }
}
