{
  "name": "step-security/semantic-release-action",
  "version": "6.0.0",
  "description": "GitHub Action for Semantic Release",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.js --bundle --platform=node --conditions=import --external:typescript --external:semantic-release --outfile=dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/step-security/semantic-release-action.git"
  },
  "keywords": [
    "semantic-release",
    "action"
  ],
  "author": "step-security",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/step-security/semantic-release-action/issues"
  },
  "homepage": "https://github.com/step-security/semantic-release-action#readme",
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/io": "^3.0.2",
    "@cycjimmy/awesome-js-funcs": "^4.0.9",
    "axios": "^1.19.0",
    "semantic-release": "^25.0.8"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
